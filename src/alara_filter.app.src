{application, alara_filter, [
    {description, "em_filter agent exposing the ALARA distributed entropy API"},
    {vsn, "0.2.0"},
    {registered, [alara_filter_sup, alara_filter_server]},
    {mod, {alara_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter,
        alara
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        alara_filter_sup,
        alara_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/alara_filter"}]}
]}.
